<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="uk.co.jmaul.orionuo"
    android:versionCode="1"
    android:versionName="1.0"
    android:installLocation="auto">

    <!-- Without this, targetSdkVersion defaults to 1: Android then applies
         compatibility mode and modern devices refuse to install the package.
         minSdk 21 matches what the native code is compiled against. -->
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />

    <!-- The renderer draws through shaders and vertex attributes. -->
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- The UO data files are ~2.6 GB and cannot be redistributed, so they are
         side-loaded rather than packaged, and read from external storage. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <!-- The client talks to the shard over a raw TCP socket. Without this the
         connect() fails with EPERM and the login screen reports "There is some
         problem communicating with Origin". -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hardwareAccelerated="true">

        <activity
            android:name="uk.co.jmaul.orionuo.OrionActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleInstance">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
